{
  "app-id": "com.besupernow.atlas",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "atlas",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=all",
    "--own-name=org.mpris.MediaPlayer2.com_besupernow_atlas",
    "--system-talk-name=org.freedesktop.NetworkManager",
    "--filesystem=xdg-run/os_media_controls_artwork:create",
    "--filesystem=xdg-run/discord-ipc-0",
    "--filesystem=xdg-run/discord-ipc-1",
    "--filesystem=xdg-run/discord-ipc-2",
    "--filesystem=xdg-run/discord-ipc-3",
    "--filesystem=xdg-run/discord-ipc-4",
    "--filesystem=xdg-run/discord-ipc-5",
    "--filesystem=xdg-run/discord-ipc-6",
    "--filesystem=xdg-run/discord-ipc-7",
    "--filesystem=xdg-run/discord-ipc-8",
    "--filesystem=xdg-run/discord-ipc-9",
    "--filesystem=xdg-run/app/com.discordapp.Discord:ro",
    "--env=GTK_USE_PORTAL=1"
  ],
  "build-options": {
    "strip": false,
    "no-debuginfo": true
  },
  "modules": [
    {
      "name": "atlas",
      "buildsystem": "simple",
      "build-commands": [
        "cp -a bundle /app/atlas",
        "install -Dm755 atlas /app/bin/atlas",
        "install -Dm644 com.besupernow.atlas.desktop /app/share/applications/com.besupernow.atlas.desktop",
        "install -Dm644 com.besupernow.atlas.metainfo.xml /app/share/metainfo/com.besupernow.atlas.metainfo.xml",
        "install -Dm644 atlas.png /app/share/icons/hicolor/512x512/apps/com.besupernow.atlas.png",
        "chmod 755 /app/atlas/atlas.sh",
        "if test -f /app/atlas/lib/crashpad_handler; then chmod 755 /app/atlas/lib/crashpad_handler; fi",
        "if test -f /app/atlas/lib/gstreamer-1.0/gst-plugin-scanner; then chmod 755 /app/atlas/lib/gstreamer-1.0/gst-plugin-scanner; fi",
        "python3 relocate-caches.py /app/atlas"
      ],
      "sources": [
        { "type": "dir", "path": "bundle", "dest": "bundle" },
        { "type": "file", "path": "atlas" },
        { "type": "file", "path": "relocate-caches.py" },
        { "type": "file", "path": "com.besupernow.atlas.desktop" },
        { "type": "file", "path": "com.besupernow.atlas.metainfo.xml" },
        { "type": "file", "path": "atlas.png" }
      ]
    }
  ]
}
